# Backend API URL for production deployment (e.g., Render, Railway)
# When set, API requests from the frontend will route to this URL.
# If left empty in local dev, requests will use the Vite dev proxy to http://localhost:5000
VITE_API_URL=https://your-backend-app.onrender.com

# Google OAuth Client ID (optional, for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=272521297941-qis4ot0k4a9k9ll0sv1h7heal54ule9f.apps.googleusercontent.com
